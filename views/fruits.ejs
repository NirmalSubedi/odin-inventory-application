<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>

    <body>
        <main>

            <%- include('partials/pageTitle') %>
                <% if (locals.fruits?.length> 0) { %>
                    <ul>
                        <% locals.fruits.forEach(fruit=> { %>
                            <li><a href="/fruits/<%= fruit.fruit %>">
                                    <span class="fruitNameText">
                                        <%= fruit.fruit %>
                                    </span>
                                </a>
                            </li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p>None, no fruits have been added.</p>
                        <% } %>
        </main>
        <%- include('partials/footer') %>
    </body>

</html>