<!DOCTYPE html>
<html lang="en">

  <%- include('partials/head') %>

  <body>
    <main>
      <%- include('partials/pageTitleWithColors') %>
      <% if (locals.fruits?.length> 0) { %>
      <p>List of created fruits:</p>
      <ul>
        <% locals.fruits.forEach(fruit=> { %>
        <li>
          <a href="/fruits/<%= fruit.fruit %>">
            <span class="fruitNameText">
              <%= fruit.fruit %>
            </span>
          </a>
          <div class="colorFieldLinksContainer">
            <a href="/fruits/<%= fruit.fruit %>/update">
              Update
            </a>&nbsp;|&nbsp; 
            <form
              action="/fruits/<%= fruit.fruit %>/delete"
              style="display: inline;"
              method="post"
            >
              <input type="hidden" class="secret" name="secret">
              <button
                type="submit"
                onclick="return confirm('Are you sure you want to delete the fruit <%= fruit.fruit%>?')"
              >Delete</button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <p>No fruits found.</p>
      <% } %>
      <p>Missing a fruit? Feel free, to <a href="fruits/create">create the fruit</a> to
        add to the list.</p>
    </main>
    <%- include('partials/footer') %>
  </body>

</html>
