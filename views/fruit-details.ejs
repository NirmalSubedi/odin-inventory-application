<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <%- include('partials/page-title') %>
        <% if (locals.fruitDetails?.length>0) { %>
            <% locals.fruitDetails?.forEach(([field,colors])=> { %>
                <section>
                    <h2 class="fruit-detail-field-name">
                        <%= field.split('_').join(' ') %>:
                </h2>
                <ul>
                    <% colors.forEach(color=> { %>
                        <%- include( "partials/color", {color, text: color}) %>
                        <% }) %>
                            </ul>
            </section>
            <% }) %>
                <% } else { %>
                    <p>
                        No details available about <%= locals.fruit || ' fruit' %>.
                            </p>
                            <% } %>
                                <%- include('partials/footer') %>
</body>

</html>