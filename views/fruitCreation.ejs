<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('partials/head') %>
  </head>
 
  <body>  
    <main>  
      <%- include('partials/pageTitle') %>
      <form action="/fruits/create" method="post"> 
        <div
          class="formFieldGroup <% if (locals.errors) { %> formFieldGroupError <% } %>"
        > 
          <%- include('partials/errorsList', {id:'createFruitError'}) %> 
          <%- include('partials/fruitInput', { label: 'Fruit Name:' , name: 'fruit', 
          placeholder: 'e.g. Apple', value: locals.fruit, errorIds: ['fruitError'] }) %>
          <%- include('partials/colorInput', {name: 'fruitColor' , label:`Fruit Color:`,
          errorIds:["createFruitError", "fruitColorError" ], defaultOptionValue:`-- Select a fruit
          color --`, colorOpts:locals.fruitColors, selectOption: locals.fruitColorSelect}) %>
          <%- include('partials/colorInput', {name: 'peelColor' , label:`Peel Color:`,
          errorIds:["createFruitError", "peelColorError" ], defaultOptionValue:`-- Select a
          peel color --`, colorOpts:locals.peelColors, selectOption: locals.peelColorSelect})
          %>
        </div>   
        <button type="submit">Create Fruit</button>
      </form>
    </main>
    <%- include('partials/footer') %>

  </body>

</html>
