<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <main>
        <%- include('partials/pageTitle') %>
            <form action="/fruits/create" method="post">
                <div class="formFieldGroup <% if (locals.errors){%>formFieldGroupError<%} %>">
                    <%- include('partials/errorsList', {id:'createFruitError'}) %>
                        <p class="formField">
                            <label for="fruit">Fruit Name:</label>
                            <input type="text" name="fruit" id="fruit" placeholder="e.g. Apple" <% if (locals.fruit) {
                                %>value='<%= locals.fruit %>'<% } %>>
                        </p>
                        <%- include('partials/colorInput', {name: 'fruitColor' , label:`Fruit Color:`,
                            errorIds:["createFruitError", "fruitColorError" ], defaultOptionValue:`-- Select a fruit
                            color --`, colorOpts:locals.fruitColors}) %>
                            <%- include('partials/colorInput', {name: 'peelColor' , label:`Peel Color:`,
                                errorIds:["createFruitError", "peelColorError" ], defaultOptionValue:`-- Select a peel
                                color --`, colorOpts:locals.peelColors}) %>
                </div>
                <button type="submit">Create Fruit</button>
            </form>
    </main>
    <%- include('partials/footer') %>

</body>

</html>