<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <main>
        <%- include('partials/pageTitle') %>
            <% if (locals.fruit && locals.fruitDetails) { %>
                <%- include('partials/fruitDetail', {fieldLabel:'Fruit Colors', fruitDetail:'fruit_colors'}) %>
                    <%- include('partials/fruitDetail', {fieldLabel:'Peel Colors', fruitDetail:'peel_colors'}) %>
                        <% } else { %>
                            <p>
                                No details available about <%= locals.fruit || ' fruit' %>.
                            </p>
                            <% } %>
    </main>
    <%- include('partials/footer') %>
</body>

</html>