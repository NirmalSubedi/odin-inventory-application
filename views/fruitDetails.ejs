<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('partials/head') %>
  </head>

  <body>
    <main>
      <%- include('partials/pageTitle') %>
      <% if (locals.doesFruitExist) { %>
      <%- include('partials/fruitDetail', {fieldLabel:'Fruit Color', fruitDetail:'fruit_colors',
      createPath: 'fruitColor' }) %>
      <%- include('partials/fruitDetail', {fieldLabel:'Peel Color', fruitDetail:'peel_colors',
      createPath: 'peelColor' }) %>
      <% } else { %>
      <p>
        No details available about <%= locals.fruit || ' fruit' %>.
        <a href="./create">Create fruit</a> to add details about <%= locals.fruit %>.
      </p>
      <% } %>
    </main>
    <%- include('partials/footer') %>
  </body>

</html>
