<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <main>
        <%- include('partials/pageTitle') %>
            <% if (locals.fruitDetails?.length>0) { %>
                <% locals.fruitDetails?.forEach(([field,colors])=> { %>
                    <section>
                        <h2 class="fruitDetailFieldName">
                            <%= field.split('_').join(' ') %>:
                    </h2>
                    <ul>
                        <% colors.forEach(color=> { %>
                            <li>
                                <%- include( "partials/color", {color, text: color}) %>
                            </li>
                            <% }) %>
                                </ul>
                </section>
                <% }) %>
                    <% } else { %>
                        <p>
                            No details available about <%= locals.fruit || ' fruit' %>.
                                </p>
                                <% } %>
    </main>
    <%- include('partials/footer') %>
</body>

</html>