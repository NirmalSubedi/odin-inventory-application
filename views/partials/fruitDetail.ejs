<section>
  <% const details=locals.fruitDetails?.[locals.fruitDetail]?.split(locals.delimiter)%>
  
  <h2 class="fruitDetailFieldName">
    <% if (details?.length>1) { %>
      <%= locals.fieldLabel %>s:
    <% } else { %>
      <%= locals.fieldLabel %>:
    <% } %>
  </h2>

  <ul>
    <% details?.forEach(color=> {%>
    <li>
      <%- include('color', {color, text:color}) %>
      <div class="colorFieldLinksContainer">
        <a href="/fruits/<%= locals.fruit %>/<%= locals.createPath %>/<%= color %>/update">
        Update
        </a>
        &nbsp;|&nbsp; 
        <form
              action="/fruits/<%= locals.fruit %>/<%= locals.createPath %>/<%= color %>/delete"
              style="display: inline"
              method="post"
            >
              <input type="hidden" class="secret" name="secret">
              <button
                type="submit"
                onclick="return confirm('Are you sure you want to delete <%=color%> <%= locals.fieldLabel.toLowerCase()%> for <%= locals.fruit%>?')"
              >Delete</button>
            </form>
        </div>
    </li>
    <% }) %>
  </ul>
  <a href="/fruits/<%= locals.fruit %>/<%= locals.createPath %>">
    Add <%= fieldLabel %>
  </a>
</section>