<section>
    <% const details=locals.fruitDetails[locals.fruitDetail].split(locals.delimiter)%>
        <h2 class="fruitDetailFieldName">
            <% if (details.length>1) { %>
                <%= locals.fieldLabel %>s:
                    <% } else { %>
                        <%= locals.fieldLabel %>:
                            <% } %>
        </h2>
        <ul>
            <% details.forEach(color=> {%>
                <li><%- include('color', {color, text:color}) %></li>
                <% }) %>
                    <a href="/fruits/<%= locals.fruit %>/<%= locals.fruitDetail %>">Add <%= fieldLabel %></a>
        </ul>
</section>