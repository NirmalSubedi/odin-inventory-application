<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>

    <body>
        <main>
            <%- include('partials/pageTitle') %>
                <p>Find out which colored fruits are fresh and safe to munch.</p>
                <form action="/colors/search" method="post">
                    <div class="formField">
                        <label for="searchColor" class="searchColorLabel">Search By Color:</label>
                        <select id="searchColor" name="searchColor" class="colorSelect"
                            aria-describedby="searchColorError">
                            <option value="" disabled hidden selected>-- Select a color --</option>
                            <% if (locals.fruitColors) { %>
                                <optgroup label="Fruit Color">
                                    <%- include('partials/colorOptions', {colorOpts: fruitColors,
                                        prefix:'fruit-color:'}) %>
                                </optgroup>
                                <% } %>
                                    <% if (locals.peelColors) { %>
                                        <optgroup label="Peel Color">
                                            <%- include('partials/colorOptions', {colorOpts: peelColors,
                                                prefix:'peel-color:'}) %>
                                        </optgroup>
                                        <% } %>
                        </select>
                        <% if (locals.errors?.searchColor) { %>
                            <%- include('partials/fieldError', {id:'searchColorError', error:
                                locals.errors.searchColor}) %>
                                <% } %>
                    </div>
                    <button type="submit">Search</button>
                </form>
                <%- include('partials/nav') %>
        </main>
        <%- include('partials/footer') %>
    </body>

</html>