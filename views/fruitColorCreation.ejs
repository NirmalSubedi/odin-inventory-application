<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <main>
        <%- include('partials/pageTitle') %>
            <form action="/fruits/<%= locals.fruit %>/<%= locals.colorField %>" method="post">
                <div class="formFieldGroup <% if (locals.errors){%>formFieldGroupError<%} %>">
                    <%- include('partials/errorsList', {id:'createFruitColorError'}) %>
                        <input type="hidden" value="<%= locals.fruit %>" name="fruit">
                        <input type="hidden" value="<%= locals.colorField %>" name="colorField">
                        <%- include('partials/colorInput', {name: locals.colorField, label:locals.colorFieldLabel,
                            selectOption: locals.colorSelect}) %>
                </div>
                <button type="submit" class="fruitColorCreationButton">
                    <%= locals.buttonText || 'Create' %>
                </button>
            </form>
    </main>
    <%- include('partials/footer') %>

</body>

</html>