<!DOCTYPE html>
<html lang="en">

  <head>
    <%- include('partials/head') %>
  </head>

  <body>
    <main>
      <%- include('partials/pageTitle') %>
      <form
        action="/fruits/<%= locals.fruit %>/<%= locals.colorField %>"
        method="post"
      >
        <div
          class="formFieldGroup <% if (locals.errors){ %> formFieldGroupError <%}%>"
        >
          <%- include('partials/errorsList', {id:'createFruitColorError'}) %>
          <%- include('partials/colorInput', {name: locals.colorField, label:locals.colorFieldLabel}) %>
        </div>
        <button type="submit" class="fruitColorCreationButton">
          <%= locals.buttonText || 'Create' %>
        </button>
      </form>
    </main>
    <%- include('partials/footer') %>

  </body>

</html>
