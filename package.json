{
  "name": "odin-inventory-application",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "// dev": "Start development server",
    "dev": "node --env-file-if-exists=.env.dev --watch-path=. --watch-preserve-output app.js",
    "// build": "Run script for for server hosting service",
    "build": "node --env-file-if-exists=.env app.js",
    "// preview": "Locally preview app in production environment",
    "preview": "node --env-file-if-exists=.env --watch-path=. --watch-preserve-output app.js",
    "// populateDB": "Populate the database with dummy data",
    "populateDB": "node --env-file-if-exists=.env.dev ./db/populateDB.js"
  },
  "keywords": [],
  "author": "",
